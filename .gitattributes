# Handle line endings automatically
* text=auto

# Python files
*.py text eol=lf

# Config files
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf

# Markdown
*.md text eol=lf

# Windows specific
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files – don't mess with them
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pt binary
*.pth binary
*.h5 binary
*.hdf5 binary
